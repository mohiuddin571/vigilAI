# Copy this file to .env at the repo root and fill in values.
# app/core/config.py is the only module that reads these — see TD-13.

# Required. One of: development, staging, production.
ENVIRONMENT=development

# Optional (defaults shown).
LOG_LEVEL=INFO
CORS_ALLOW_ORIGINS=["http://localhost:5173"]

# Required (M3). Camera passwords are encrypted at rest with this key (TD-15,
# TD-18) — generate your own per machine, never share or commit one:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CAMERA_CREDENTIAL_ENCRYPTION_KEY=replace-with-a-generated-fernet-key

# Optional. SQLite file for onboarded cameras (TD-09); defaults to
# storage/db/vigilai.db under the repo root, so most setups can leave this
# unset. Set DATABASE_URL to override, e.g.:
# DATABASE_URL=sqlite+aiosqlite:////absolute/path/to/vigilai.db

# Optional. RTMP Push/Consume Demo (docs/RTMP_DEMO.md) — an isolated demo
# page, outside the graded milestone sequence. Requires `mediamtx` on PATH
# (`brew install mediamtx`); defaults below work with no changes.
# RTMP_SERVER_HOST=localhost
# RTMP_SERVER_PORT=1935
# RTMP_APP_NAME=live
# RTMP_STREAM_KEY=demo-camera
# Leave both halves of a pair unset to disable that check (local-demo
# default, documented as intentionally simplified in docs/RTMP_DEMO.md).
# RTMP_PUBLISH_USERNAME=
# RTMP_PUBLISH_PASSWORD=
# RTMP_READ_USERNAME=
# RTMP_READ_PASSWORD=
